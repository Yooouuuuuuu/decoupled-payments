# Credit model (thesis Fig. 3.1): Alice sends $10 to Bob in two phases.

direction: right

s0: Before {
  alice: "Alice's account\n\$100"
  bob: "Bob's account\n\$100"
  credits: "Credits of Bob\n(empty)"
}

s1: "After validation\n(sender account update)" {
  alice: "Alice's account\n\$90"
  bob: "Bob's account\n\$100"
  credits: "Credits of Bob\n+10"
}

s2: "After credit\n(receiver account update)" {
  alice: "Alice's account\n\$90"
  bob: "Bob's account\n\$110"
  credits: "Credits of Bob\n(empty)"
}

s0 -> s1: 'validate: Alice has >= $10'
s1 -> s2: 'apply credit, no checks'
